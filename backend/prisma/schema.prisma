generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model IdempotencyKey {
  userId      String   @map("user_id") @db.Uuid
  key         String
  fingerprint String
  statusCode  Int?     @map("status_code")
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([userId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

enum Role {
  AUCTIONEER
  BIDDER
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  wallet        Wallet?
  ledgerEntries LedgerEntry[]
  lotsSelling   Lot[]         @relation("seller")
  lotsLeading   Lot[]         @relation("leader")
  lotsWon       Lot[]         @relation("winner")
  bids          Bid[]
  receipts      Receipt[]

  @@map("users")
}

enum LedgerEntryType {
  DEPOSIT
  HOLD
  RELEASE
  CAPTURE
  PAYOUT
  REFUND
}

/// Projection of the ledger; also the row locked when money moves.
model Wallet {
  userId         String   @id @map("user_id") @db.Uuid
  balanceCents   BigInt   @default(0) @map("balance_cents")
  committedCents BigInt   @default(0) @map("committed_cents")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@map("wallets")
}

model LedgerEntry {
  id          BigInt          @id @default(autoincrement())
  userId      String          @map("user_id") @db.Uuid
  type        LedgerEntryType
  amountCents BigInt          @map("amount_cents")
  lotId       String?         @map("lot_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("ledger_entries")
}

enum ImageStatus {
  PENDING
  MIRRORED
  FAILED
}

enum TranslationOrigin {
  ORACLE
  PRINTED
  SIBLING
}

/// A Scryfall printing in one language. Rows are never updated, so a lot can reference them as a snapshot.
model CatalogItem {
  id              String      @id @default(uuid(7)) @db.Uuid
  scryfallId      String      @unique @map("scryfall_id") @db.Uuid
  oracleId        String?     @map("oracle_id") @db.Uuid
  setCode         String      @map("set_code")
  setName         String      @map("set_name")
  collectorNumber String      @map("collector_number")
  lang            String
  rarity          String
  manaCost        String?     @map("mana_cost")
  colors          String[]
  artist          String?
  releasedAt      DateTime?   @map("released_at") @db.Date
  referencePrice  Json?       @map("reference_price")
  sourceImageUrl  String?     @map("source_image_url")
  imageStatus     ImageStatus @default(PENDING) @map("image_status")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  translations CatalogItemTranslation[]
  image        CatalogImage?
  jobs         CatalogJob[]
  lots         Lot[]

  @@map("catalog_items")
}

model CatalogItemTranslation {
  itemId     String            @map("item_id") @db.Uuid
  locale     String
  name       String
  typeLine   String?           @map("type_line")
  rulesText  String?           @map("rules_text")
  flavorText String?           @map("flavor_text")
  origin     TranslationOrigin

  item CatalogItem @relation(fields: [itemId], references: [id])

  @@id([itemId, locale])
  @@map("catalog_item_translations")
}

model CatalogImage {
  itemId      String   @id @map("item_id") @db.Uuid
  contentType String   @map("content_type")
  data        Bytes
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  item CatalogItem @relation(fields: [itemId], references: [id])

  @@map("catalog_images")
}

enum CatalogJobType {
  IMAGE_MIRROR
  TRANSLATE
}

enum JobStatus {
  PENDING
  DONE
  FAILED
}

model CatalogJob {
  id        String         @id @default(uuid(7)) @db.Uuid
  type      CatalogJobType
  itemId    String         @map("item_id") @db.Uuid
  status    JobStatus      @default(PENDING)
  attempts  Int            @default(0)
  runAfter  DateTime       @default(now()) @map("run_after") @db.Timestamptz(3)
  lastError String?        @map("last_error")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  item CatalogItem @relation(fields: [itemId], references: [id])

  @@unique([type, itemId])
  @@index([status, runAfter])
  @@map("catalog_jobs")
}

enum LotStatus {
  OPEN
  SETTLED
  CANCELLED
}

model Lot {
  id                 String    @id @db.Uuid
  sellerId           String    @map("seller_id") @db.Uuid
  itemId             String    @map("item_id") @db.Uuid
  startingPriceCents BigInt    @map("starting_price_cents")
  minIncrementCents  BigInt    @map("min_increment_cents")
  startsAt           DateTime  @map("starts_at") @db.Timestamptz(3)
  /// Moves forward with anti-sniping; originalEndsAt keeps the signed value.
  endsAt             DateTime  @map("ends_at") @db.Timestamptz(3)
  originalEndsAt     DateTime  @map("original_ends_at") @db.Timestamptz(3)
  status             LotStatus @default(OPEN)
  currentPriceCents  BigInt?   @map("current_price_cents")
  currentLeaderId    String?   @map("current_leader_id") @db.Uuid
  bidCount           Int       @default(0) @map("bid_count")
  genesisHash        String    @map("genesis_hash")
  genesisSignature   String    @map("genesis_signature")
  headHash           String    @map("head_hash")
  winnerId           String?   @map("winner_id") @db.Uuid
  finalPriceCents    BigInt?   @map("final_price_cents")
  settledAt          DateTime? @map("settled_at") @db.Timestamptz(3)
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  seller User        @relation("seller", fields: [sellerId], references: [id])
  leader User?       @relation("leader", fields: [currentLeaderId], references: [id])
  winner User?       @relation("winner", fields: [winnerId], references: [id])
  item   CatalogItem @relation(fields: [itemId], references: [id])
  bids    Bid[]
  receipt Receipt?

  @@index([status, endsAt])
  @@index([status, startsAt])
  @@index([sellerId])
  @@map("lots")
}

/// Events written in the same transaction as the change, then streamed to SSE clients.
model OutboxEvent {
  id        BigInt                 @id @default(autoincrement())
  type      String
  lotId     String?                @map("lot_id") @db.Uuid
  /// Set for private events, delivered only to this user.
  userId    String?                @map("user_id") @db.Uuid
  payload   Json
  txId      Unsupported("xid8")    @default(dbgenerated("pg_current_xact_id()")) @map("tx_id")
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([txId, id])
  @@index([createdAt])
  @@map("outbox_events")
}

/// Append-only; each row is a signed link of the lot's hash chain.
model Bid {
  id          String   @id @default(uuid(7)) @db.Uuid
  lotId       String   @map("lot_id") @db.Uuid
  seq         Int
  bidderId    String   @map("bidder_id") @db.Uuid
  bidderAlias String   @map("bidder_alias")
  amountCents BigInt   @map("amount_cents")
  createdAt   DateTime @map("created_at") @db.Timestamptz(3)
  prevHash    String   @map("prev_hash")
  hash        String
  signature   String

  lot    Lot  @relation(fields: [lotId], references: [id])
  bidder User @relation(fields: [bidderId], references: [id])

  @@unique([lotId, seq])
  @@index([bidderId])
  @@map("bids")
}

/// Proof of purchase; the seal signs the final state of the bid chain.
model Receipt {
  id            String   @id @default(uuid(7)) @db.Uuid
  lotId         String   @unique @map("lot_id") @db.Uuid
  /// Unguessable token used in the public share link.
  publicToken   String   @unique @map("public_token")
  winnerId      String   @map("winner_id") @db.Uuid
  winnerAlias   String   @map("winner_alias")
  amountCents   BigInt   @map("amount_cents")
  bidCount      Int      @map("bid_count")
  finalHash     String   @map("final_hash")
  sealSignature String   @map("seal_signature")
  issuedAt      DateTime @map("issued_at") @db.Timestamptz(3)

  lot    Lot  @relation(fields: [lotId], references: [id])
  winner User @relation(fields: [winnerId], references: [id])

  @@map("receipts")
}
